{
  "name": "dashtop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "dev:studio": "cd apps/studio && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:studio\"",
    "build": "cd apps/web && npm run build",
    "build:studio": "cd apps/studio && npm run build",
    "db:push": "cd apps/web && npx prisma db push",
    "db:seed": "cd apps/web && npx tsx ../../prisma/seed.ts",
    "db:generate": "cd apps/web && npx prisma generate"
  }
}
